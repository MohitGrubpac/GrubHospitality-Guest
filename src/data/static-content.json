  "faqs": [
    {
      "id": "faq-1",
      "question": "How to i place an order?",
      "answer": "Select dishes from any restaurant menu, customize your order, choose instant delivery or schedule time, and click place order."
    },
    {
      "id": "faq-2",
      "question": "How do I schedule a meal?",
      "answer": "Use the schedule banner on the home screen to pick a future date and time slot for your food delivery."
    },
    {
      "id": "faq-3",
      "question": "How does the Smart Food Box work?",
      "answer": "Your order is delivered directly to your room's secure thermal food box, keeping your meals fresh and hot."
    },
    {
      "id": "faq-4",
      "question": "Can I cancel my order?",
      "answer": "You can cancel your order within 2 minutes of placing it directly from the Order Status section."
    },
    {
      "id": "faq-5",
      "question": "How can I modify my order?",
      "answer": "To modify items or special notes, contact hotel room dining reception before the order enters preparation."
    },
    {
      "id": "faq-6",
      "question": "What should I do if my food is delayed?",
      "answer": "You can track real-time kitchen status in the app or click CALL RECEPTION to speak directly with guest service."
    }
  ],
